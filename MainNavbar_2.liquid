<nav class="menu-bar" aria-expanded="true">
    <ul id="menu-header-menu" class="menu nav-list">
        {%- for menuItem in Model.RootItems -%}
            {%- assign atarget = "_self" -%}
            {%- assign classValues = "" -%}
            {%- if menuItem.IsActiveAncestor == true -%}
                {%- assign classValues = "active-page-ancestor" -%}
            {%- endif -%}
            {%- if menuItem.IsActiveItem == true -%}
                {%- assign classValues = "active-page" -%}
            {%- endif -%}
            {%- if menuItem.IsActivePageParent == true -%}
                {%- assign classValues = "active-page-parent" -%}
            {%- endif -%}
            {%- assign isServicesMenu = false -%}
            {%- if menuItem.DisplayText == "Services" -%}
                {%- assign isServicesMenu = true -%}
            {%- endif -%}

            <li id="{{ menuItem.MenuItemId }}" class="nav-item {{ classValues }} {{ menuItem.MenuItemClassString }}{% if isServicesMenu %} mega-menu-item{% endif %}">
                {%- if menuItem.Url != null -%}
                    {%- if Model.WindowTarget != null -%}
                        {%- assign atarget = Model.WindowTarget -%}
                    {%- endif -%}
                    {%- if menuItem.ChildItems.size > 0 -%}
                        <a class="nav-link" target="{{ atarget }}">
                    {%- else -%}
                        <a href="{{ menuItem.Url | friendly_url }}" class="nav-link" target="{{ atarget }}">
                    {%- endif -%}
                    {%- if menuItem.ImageContentRef != null -%}
                        {%- assign contentImage = menuItem.ImageContentRef | get_image -%}
                        {%- assign svgImage = menuItem.ImageContentRef | get_vector_image -%}
                        {%- if contentImage != "" -%}
                            {%- if svgImage != null and contentImage.FileExt == "svg" -%}
                                {{ svgImage.SvgData }}
                            {%- else -%}
                                <img src="{{ contentImage.Url }}" alt="{{ contentImage.ImgAlt }}" decoding="async" />
                            {%- endif -%}
                        {%- endif -%}
                    {%- else -%}
                        {{ menuItem.DisplayText }}
                    {%- endif -%}
                    </a>
                    {%- if menuItem.ChildItems.size > 0 -%}
                        <button type="button" class="nav-sub-toggle" aria-expanded="false" aria-label="Toggle {{ menuItem.DisplayText }} submenu">
                            <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M11.4432 0.438023L12.5032 1.49902L6.7262 7.27802C6.63364 7.37118 6.52356 7.44511 6.40231 7.49555C6.28106 7.546 6.15103 7.57197 6.0197 7.57197C5.88838 7.57197 5.75835 7.546 5.6371 7.49555C5.51585 7.44511 5.40577 7.37118 5.3132 7.27802L-0.466797 1.49902L0.593203 0.439023L6.0182 5.86302L11.4432 0.438023Z" fill="#fff" />
                            </svg>
                        </button>
                    {%- endif -%}
                {%- else -%}
                    <button type="button" class="nav-button">
                        {%- if menuItem.ImageContentRef != null -%}
                            {%- assign contentImage = menuItem.ImageContentRef | get_image -%}
                            {%- assign svgImage = menuItem.ImageContentRef | get_vector_image -%}
                            {%- if contentImage != "" -%}
                                {%- if svgImage != null and contentImage.FileExt == "svg" -%}
                                    {{ svgImage.SvgData }}
                                {%- else -%}
                                    <img src="{{ contentImage.Url }}" alt="{{ contentImage.ImgAlt }}" decoding="async" />
                                {%- endif -%}
                            {%- endif -%}
                        {%- else -%}
                            {{ menuItem.DisplayText }}
                        {%- endif -%}
                        <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M11.4432 0.438023L12.5032 1.49902L6.7262 7.27802C6.63364 7.37118 6.52356 7.44511 6.40231 7.49555C6.28106 7.546 6.15103 7.57197 6.0197 7.57197C5.88838 7.57197 5.75835 7.546 5.6371 7.49555C5.51585 7.44511 5.40577 7.37118 5.3132 7.27802L-0.466797 1.49902L0.593203 0.439023L6.0182 5.86302L11.4432 0.438023Z" fill="#fff" />
                        </svg>
                    </button>
                {%- endif -%}

                {%- if menuItem.ChildItems.size > 0 -%}
                    {%- if isServicesMenu -%}
                        <ul class="mega-sub-menu">
                            <li class="mega-menu-row">
                                <div class="mega-sub-menu-grid">
                                    <div class="mega-menu-column newmenu-col-1">
                                        <div class="all-services-block">
                                            <h2>Together, we can create a better healthcare experience for everyone</h2>
                                            <a class="btn all-services" href="/our-services/">
                                                <div class="as-button">All Services</div>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="mega-menu-column newmenu-col-2">
                                        <ul class="mega-sub-menu-list">
                                            {%- assign counter = 0 -%}
                                            {%- for childItem in menuItem.ChildItems -%}
                                                {%- assign counter = counter | plus: 1 -%}
                                                {%- if counter <= 6 -%}
                                                    <li class="mega-menu-item">
                                                        <a class="mega-menu-link" href="{{ childItem.Url | friendly_url }}">{{ childItem.DisplayText | split: "(" | first | strip }}</a>
                                                    </li>
                                                {%- endif -%}
                                            {%- endfor -%}
                                        </ul>
                                    </div>
                                    <div class="mega-menu-column newmenu-col-3">
                                        <ul class="mega-sub-menu-list">
                                            {%- assign counter = 0 -%}
                                            {%- for childItem in menuItem.ChildItems -%}
                                                {%- assign counter = counter | plus: 1 -%}
                                                {%- if counter > 6 -%}
                                                    <li class="mega-menu-item">
                                                        <a class="mega-menu-link" href="{{ childItem.Url | friendly_url }}">{{ childItem.DisplayText | split: "(" | first | strip }}</a>
                                                    </li>
                                                {%- endif -%}
                                            {%- endfor -%}
                                        </ul>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    {%- else -%}
                        <ul>
                            {%- for childItem in menuItem.ChildItems -%}
                                {%- assign templatePath = "MenuItem.liquid" | get_templatepath -%}
                                {%- include templatePath, Model: childItem -%}
                            {%- endfor -%}
                        </ul>
                    {%- endif -%}
                {%- endif -%}
            </li>
        {%- endfor -%}
    </ul>

    <div class="nav-mobile-search">
        <button type="button" class="nav-mobile-search-btn" aria-label="Open search">
            <svg width="32" height="32" viewBox="0 0 31 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20.0667 21L15.8667 16.8C15.5333 17.0667 15.15 17.2778 14.7167 17.4333C14.2833 17.5889 13.8222 17.6667 13.3333 17.6667C12.1222 17.6667 11.0973 17.2471 10.2587 16.408C9.42 15.5689 9.00044 14.544 9 13.3333C8.99956 12.1227 9.41911 11.0978 10.2587 10.2587C11.0982 9.41956 12.1231 9 13.3333 9C14.5436 9 15.5687 9.41956 16.4087 10.2587C17.2487 11.0978 17.668 12.1227 17.6667 13.3333C17.6667 13.8222 17.5889 14.2833 17.4333 14.7167C17.2778 15.15 17.0667 15.5333 16.8 15.8667L21 20.0667L20.0667 21ZM13.3333 16.3333C14.1667 16.3333 14.8751 16.0418 15.4587 15.4587C16.0422 14.8756 16.3338 14.1671 16.3333 13.3333C16.3329 12.4996 16.0413 11.7913 15.4587 11.2087C14.876 10.626 14.1676 10.3342 13.3333 10.3333C12.4991 10.3324 11.7909 10.6242 11.2087 11.2087C10.6264 11.7931 10.3347 12.5013 10.3333 13.3333C10.332 14.1653 10.6238 14.8738 11.2087 15.4587C11.7936 16.0436 12.5018 16.3351 13.3333 16.3333Z" fill="#111"></path>
            </svg>
            <span>Search</span>
        </button>
    </div>
</nav>
